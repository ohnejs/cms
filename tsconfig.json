{
  "compilerOptions": {
    "module": "nodenext",
    "allowJs": true,
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "ohne.config.ts",
    "ohne.layer.ts",
    "api/**/*.ts",
    "boot/**/*.ts",
    "fields/**/*.ts",
    "middleware/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
