{
  "name": "@ohnejs/cms",
  "version": "0.0.1",
  "description": "Pages, routes, SEO and a live preview editor for ohne.",
  "homepage": "https://github.com/ohnejs/cms#readme",
  "license": "MIT",
  "author": "Muris Ceman <muris@ohne.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohnejs/cms.git"
  },
  "files": [
    "api",
    "boot",
    "collections",
    "dashboard",
    "fields",
    "messages",
    "middleware",
    "preview",
    "src",
    "ohne.config.ts",
    "ohne.layer.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "ohne prepare",
    "test": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile node --test --expose-gc --import ohnejs/register \"tests/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p dashboard/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "ohnejs": "0.0.1",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "ohnejs": ">=0.0.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
